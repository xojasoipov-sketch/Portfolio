# Xojasoipov Portfolio Bot — Environment Variables
# HECH QACHON haqiqiy qiymatlarni GitHub'ga push qilmang (.env gitignored).

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=              # @BotFather -> @Xojasoipovbot
TELEGRAM_ADMIN_IDS=              # vergul bilan: 8412667249,111111111
MINI_APP_URL=                    # Portfolio saytining deploy qilingan URL'i

# === AI PROVIDER ===
AI_PROVIDER=gemini               # gemini | (kelajakda: openai, anthropic)
GEMINI_API_KEY=                  # https://aistudio.google.com/apikey — bir nechta kalit bo'lsa vergul bilan: key1,key2,key3 (biri kvota tugasa avtomatik keyingisiga o'tadi)
GEMINI_MODEL=gemini-2.0-flash    # tez va bepul tier uchun

# === SUPABASE ===
SUPABASE_URL=https://tomkxsdkerpbvlumubbg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # Dashboard -> Settings -> API -> service_role (SECRET, RLS'ni bypass qiladi)

# === CONTACT (KB uchun, ixtiyoriy override) ===
CONTACT_EMAIL=xojasoipov@gmail.com
CONTACT_PHONE=+998910666777
CONTACT_TELEGRAM=@xojasoipov
CONTACT_INSTAGRAM=

# === RUNTIME ===
NODE_ENV=production
LOG_LEVEL=info                   # debug | info | warn | error
